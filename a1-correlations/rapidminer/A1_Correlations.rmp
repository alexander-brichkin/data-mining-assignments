<?xml version="1.0" encoding="UTF-8"?><process version="12.1.001">
  <context>
    <input/>
    <output/>
    <macros/>
  </context>
  <operator activated="true" class="process" compatibility="12.1.001" expanded="true" name="Process">
    <parameter key="logverbosity" value="init"/>
    <parameter key="random_seed" value="2001"/>
    <parameter key="send_mail" value="never"/>
    <parameter key="notification_email" value=""/>
    <parameter key="process_duration_for_mail" value="30"/>
    <parameter key="encoding" value="UTF-8"/>
    <process expanded="true">
      <operator activated="true" class="read_csv" compatibility="12.1.001" expanded="true" height="68" name="Read CSV" width="90" x="45" y="34">
        <parameter key="csv_file" value="sp500.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="trim_lines" value="false"/>
        <parameter key="multiline_text" value="false"/>
        <parameter key="use_quotes" value="true"/>
        <parameter key="quotes_character" value="&quot;"/>
        <parameter key="escape_character" value="\"/>
        <parameter key="skip_comments" value="false"/>
        <parameter key="comment_characters" value="#"/>
        <parameter key="starting_row" value="1"/>
        <parameter key="parse_numbers" value="true"/>
        <parameter key="decimal_character" value="."/>
        <parameter key="grouped_digits" value="false"/>
        <parameter key="grouping_character" value=","/>
        <parameter key="infinity_representation" value=""/>
        <parameter key="date_format" value=""/>
        <parameter key="use_header_row" value="true"/>
        <parameter key="header_row" value="1"/>
        <parameter key="first_row_as_names" value="true"/>
        <list key="annotations"/>
        <parameter key="time_zone" value="SYSTEM"/>
        <parameter key="locale" value="English (United States)"/>
        <parameter key="encoding" value="UTF-8"/>
        <parameter key="read_all_values_as_polynominal" value="false"/>
        <list key="data_set_meta_data_information"/>
        <parameter key="read_not_matching_values_as_missings" value="true"/>
        <description align="center" color="transparent" colored="false" width="126">Read the S&amp;P 500 constituents file</description>
      </operator>
      <operator activated="true" class="filter_examples" compatibility="12.1.001" expanded="true" height="103" name="Remove Missing" width="90" x="179" y="34">
        <parameter key="parameter_expression" value=""/>
        <parameter key="condition_class" value="no_missing_attributes"/>
        <parameter key="invert_filter" value="false"/>
        <list key="filters_list"/>
        <parameter key="filters_logic_and" value="true"/>
        <parameter key="filters_check_metadata" value="true"/>
        <description align="center" color="transparent" colored="false" width="126">Complete cases only</description>
      </operator>
      <operator activated="true" class="filter_examples" compatibility="12.1.001" expanded="true" height="103" name="Keep Positive" width="90" x="313" y="34">
        <parameter key="parameter_expression" value=""/>
        <parameter key="condition_class" value="custom_filters"/>
        <parameter key="invert_filter" value="false"/>
        <list key="filters_list">
          <parameter key="filters_entry_key" value="Market Cap.gt.0"/>
          <parameter key="filters_entry_key" value="EBITDA.gt.0"/>
          <parameter key="filters_entry_key" value="Price/Sales.gt.0"/>
          <parameter key="filters_entry_key" value="Price/Book.gt.0"/>
        </list>
        <parameter key="filters_logic_and" value="true"/>
        <parameter key="filters_check_metadata" value="true"/>
        <description align="center" color="transparent" colored="false" width="126">Drop non-positive Market Cap, EBITDA, P/S, P/B</description>
      </operator>
      <operator activated="true" class="generate_attributes" compatibility="12.1.001" expanded="true" height="82" name="Derive Attributes" width="90" x="447" y="34">
        <list key="function_descriptions">
          <parameter key="Revenue" value="[Market Cap]/[Price/Sales]"/>
          <parameter key="Book Value" value="[Market Cap]/[Price/Book]"/>
          <parameter key="EBITDA Margin" value="[EBITDA]/[Revenue]"/>
          <parameter key="Range 52W pct" value="([52 Week High]-[52 Week Low])/[52 Week Low]*100"/>
          <parameter key="Price Pos 52W" value="([Price]-[52 Week Low])/([52 Week High]-[52 Week Low])"/>
        </list>
        <parameter key="keep_all" value="true"/>
        <description align="center" color="transparent" colored="false" width="126">Five derived attributes</description>
      </operator>
      <operator activated="true" class="select_attributes" compatibility="12.1.001" expanded="true" height="82" name="Numeric Only" width="90" x="581" y="34">
        <parameter key="attribute_filter_type" value="subset"/>
        <parameter key="attribute" value=""/>
        <parameter key="attributes" value="Price|Price/Earnings|Dividend Yield|Earnings/Share|52 Week Low|52 Week High|Market Cap|EBITDA|Price/Sales|Price/Book|Revenue|Book Value|EBITDA Margin|Range 52W pct|Price Pos 52W"/>
        <parameter key="use_except_expression" value="false"/>
        <parameter key="value_type" value="attribute_value"/>
        <parameter key="use_value_type_exception" value="false"/>
        <parameter key="except_value_type" value="time"/>
        <parameter key="block_type" value="attribute_block"/>
        <parameter key="use_block_type_exception" value="false"/>
        <parameter key="except_block_type" value="value_matrix_row_start"/>
        <parameter key="invert_selection" value="false"/>
        <parameter key="include_special_attributes" value="false"/>
        <description align="center" color="transparent" colored="false" width="126">Correlation needs numeric attributes only</description>
      </operator>
      <operator activated="true" class="correlation_matrix" compatibility="12.1.001" expanded="true" height="103" name="Correlation Matrix" width="90" x="715" y="34">
        <parameter key="create_weights" value="false"/>
        <parameter key="normalize_weights" value="true"/>
        <parameter key="squared_correlation" value="false"/>
        <description align="center" color="transparent" colored="false" width="126">Pearson correlation matrix</description>
      </operator>
      <connect from_op="Read CSV" from_port="output" to_op="Remove Missing" to_port="example set input"/>
      <connect from_op="Remove Missing" from_port="example set output" to_op="Keep Positive" to_port="example set input"/>
      <connect from_op="Keep Positive" from_port="example set output" to_op="Derive Attributes" to_port="example set input"/>
      <connect from_op="Derive Attributes" from_port="example set output" to_op="Numeric Only" to_port="example set input"/>
      <connect from_op="Numeric Only" from_port="example set output" to_op="Correlation Matrix" to_port="example set"/>
      <connect from_op="Correlation Matrix" from_port="example set" to_port="result 2"/>
      <connect from_op="Correlation Matrix" from_port="matrix" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <portSpacing port="sink_result 3" spacing="0"/>
    </process>
  </operator>
</process>
